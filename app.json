{
  "expo": {
    "name": "Niah Ground-Truth",
    "slug": "niah-biodiversity-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "niahbiodiversityapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Niah Ground-Truth to use the camera to photograph plant specimens and scan QR tags.",
        "NSLocationWhenInUseUsageDescription": "Allow Niah Ground-Truth to record GPS coordinates for field observations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0F4F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E5B3D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Niah Ground-Truth to capture plant photos and scan QR tags."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Niah Ground-Truth to record GPS coordinates for field observations."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}